{
    "logging": {
        "enabled": true,
        "level": "DEBUG",
        "log_to_file": true
    },
    "paths": {
        "log_file": "bybit_bot.log",
        "exported_dir": "data/exported"
    },
    "actions": {
        "enabled": [
            "export_balances",
            "export_futures_positions",
            "export_trade_history",
            "export_order_history",
            "export_recent_executions"
        ]
    },
    "request_settings": {
        "symbol": "CCUSDT",
        "lookback_days_default": 60,
        "recent_executions_limit": 10
    }
}
